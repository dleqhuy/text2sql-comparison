{
  "name": "text2sql-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --workspace frontend run build",
    "generate-client": "node scripts/generate-client.mjs",
    "test:backend": "backend/.venv/bin/python scripts/test_backend.py",
    "test:comparison": ".venv/bin/python -m unittest discover -s tests -v",
    "setup:env": "python3 scripts/setup_env.py"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.17"
  }
}
