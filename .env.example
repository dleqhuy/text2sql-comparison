LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your-api-key
LLM_MODEL=cx/gpt-6-luna

# Optional Codex SDK baseline; uses Codex login or CODEX_API_KEY / OPENAI_API_KEY.
# This model is independent of LLM_MODEL and does not use LLM_BASE_URL.
CODEX_MODEL=gpt-6-luna

# FastAPI app: run npm run setup:env to generate missing local database settings.
PROJECT_NAME=SQL / Lab
FASTAPI_ENV=development
FRONTEND_HOST=http://127.0.0.1:5173
DATABASE_URL=
# Set LOCAL_POSTGRES=0 to use an existing PostgreSQL service.
